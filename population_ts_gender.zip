```html
<!DOCTYPE html><html lang="ko"><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>인구 분석</title>
<style>
body{font:14px sans-serif;background:#f4f6fa;color:#222;padding:20px}main{max-width:1000px;margin:auto}section{background:white;padding:18px;margin:12px 0;border-radius:14px}select,input{padding:10px;border:1px solid #ddd;border-radius:8px;max-width:100%}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}.card{background:#eef2ff;padding:15px;border-radius:10px}b{font-size:23px;display:block;margin-top:10px}canvas{width:100%;height:220px}table{border-collapse:collapse;width:100%;margin-top:12px}td,th{padding:8px;border-bottom:1px solid #eee;text-align:left}th{background:#f5f6fa}div.scroll{overflow:auto;max-height:400px}
</style><main><h1>인구 데이터 분석</h1><p>CSV를 불러와 지역별 인구를 분석하세요.</p><section><input type="file" id="f" accept=".csv"><p id="msg">CSV 파일을 선택하세요.</p><div id="filters"></div></section><div class="cards"><section class="card">총인구<b id="total">—</b></section><section class="card">남성 인구<b id="male">—</b></section><section class="card">여성 인구<b id="female">—</b></section><section class="card">65세 이상 비율<b id="old">—</b></section></div><section><h3>연도별 인구 변화</h3><canvas id="trend"></canvas></section><section><h3>연령별 인구 분포</h3><canvas id="ages"></canvas></section><section><h3>지역별 현황</h3><input id="q" placeholder="지역 검색"><div class="scroll"><table id="tbl"></table></div></section></main>
<script>
const $=id=>document.getElementById(id),n=x=>(+x||0),fmt=x=>Math.round(x).toLocaleString('ko-KR');let H=[],D=[];
function csv(s){let a=[],r=[],v='',q=false;for(let i=0;i<s.length;i++){let c=s[i];if(c=='"'&&q&&s[i+1]=='"'){v+='"';i++}else if(c=='"')q=!q;else if(c==','&&!q){r.push(v);v=''}else if((c=='\n'||c=='\r')&&!q){if(c=='\r'&&s[i+1]=='\n')i++;r.push(v);if(r.some(x=>x!==''))a.push(r);r=[];v=''}else v+=c}if(v||r.length){r.push(v);a.push(r)}return a}
function ix(s){return H.findIndex(x=>x.includes(s))}
function val(r,s){return n(r[ix(s)])}
function select(id,label,vals){let e=document.createElement('select');e.id=id;e.innerHTML='<option value="">'+label+'</option>'+vals.map(x=>'<option>'+x+'</option>').join('');e.onchange=render;$('filters').append(e)}
$('f').onchange=async e=>{let file=e.target.files[0];if(!file)return;H=[];D=[];let a=csv((await file.text()).replace(/^\uFEFF/,''));H=a.shift();D=a;$('msg').textContent=fmt(D.length)+'개 행을 불러왔습니다.';$('filters').innerHTML='';['연도','시도','시군구'].forEach((s,i)=>select(s,['전체 연도','전체 시도','전체 시군구'][i],[...new Set(D.map(r=>r[ix(s)]))].sort()));render()};
function rows(){return D.filter(r=>['연도','시도','시군구'].every(s=>!$(s)?.value||r[ix(s)]==$(s).value))}
function sum(rs,p){let i=H.findIndex(x=>x.startsWith(p));return rs.reduce((a,r)=>a+n(r[i]),0)}
function ageCols(){return H.map((h,i)=>({h,i})).filter(x=>/^계_\d+세$|^계_100세 이상$/.test(x.h))}
function draw(id,labels,values){let c=$(id),w=c.clientWidth||600,h=220,dpr=devicePixelRatio||1;c.width=w*dpr;c.height=h*dpr;let x=c.getContext('2d');x.scale(dpr,dpr);let max=Math.max(1,...values),step=w/Math.max(1,values.length);values.forEach((v,i)=>{let bh=v/max*(h-40);x.fillStyle='#526df5';x.fillRect(i*step+3,h-25-bh,Math.max(2,step-6),bh);x.fillStyle='#555';x.font='10px sans-serif';if(values.length<15||i%Math.ceil(values.length/10)==0)x.fillText(labels[i],i*step+2,h-8)})}
function render(){if(!D.length)return;let R=rows(),total=sum(R,'계_'),male=sum(R,'남_'),female=sum(R,'여_'),old=sum(R,'계_65세');$('total').textContent=fmt(total);$('male').textContent=fmt(male);$('female').textContent=fmt(female);$('old').textContent=(total?old/total*100:0).toFixed(1)+'%';
let years=[...new Set(D.map(r=>r[ix('연도')]))].sort(),ts=years.map(y=>sum(R.filter(r=>r[ix('연도')]==y),'계_'));draw('trend',years,ts);
let ac=ageCols(),av=ac.map(c=>R.reduce((s,r)=>s+n(r[c.i]),0));draw('ages',ac.map(c=>c.h.replace('계_','')),av);
let q=$('q').value.toLowerCase(),list=R.filter(r=>r.join(' ').toLowerCase().includes(q)).slice(0,300),cols=['시도','시군구','동'];$('tbl').innerHTML='<tr>'+[...cols,'총인구','남성','여성','65세 이상'].map(x=>'<th>'+x+'</th>').join('')+'</tr>'+list.map(r=>'<tr>'+[...cols.map(s=>r[ix(s)]),fmt(H.reduce((s,h,i)=>s+(h.startsWith('계_')?n(r[i]):0),0)),fmt(H.reduce((s,h,i)=>s+(h.startsWith('남_')?n(r[i]):0),0)),fmt(H.reduce((s,h,i)=>s+(h.startsWith('여_')?n(r[i]):0),0)),fmt(H.reduce((s,h,i)=>s+(/^계_(6[5-9]|[7-9]\d|100)세/.test(h)||h=='계_100세 이상'?n(r[i]):0),0))].map(x=>'<td>'+x+'</td>').join('')+'</tr>').join('')}
$('q').oninput=render;window.onresize=()=>render();
</script></html>
```
